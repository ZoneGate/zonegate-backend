# ZoneGate Environment Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LITESTAR_APP=zonegate.app:app

# AI Provider Selection: "ollama" (default local) or "gemini" (Google GenAI)
LLM_PROVIDER=ollama

# Local Ollama Configuration (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini Configuration (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# Nokia / CAMARA Gateway Configuration
# Which carrier the Evidence Gateway calls.
#   rest - CAMARA REST at NOKIA_BASE_URL (the bundled mock, or a conformant
#          operator endpoint). The default, so a machine with no carrier
#          subscription still runs.
#   live - the Nokia Network as Code gateway. NOKIA_API_KEY must then be a
#          real Network as Code key; it is sent as x-api-key, not as a bearer
#          token, and NOKIA_BASE_URL is ignored.
CARRIER_MODE=live

NOKIA_BASE_URL=https://api.nokia.example.com
NOKIA_API_KEY=mock-nokia-api-key

# The live gateway. Defaults are correct for the EU Network as Code region.
NOKIA_MCP_URL=https://mcp.prodeu.apihub.nokia.io
NOKIA_API_HOST=network-as-code.nokia.rapidapi.com

# Zova 1.0.0 Persistence Path (.zova extension required)
ZOVA_DB_PATH=data/zonegate.zova

# Scoped Token HMAC Secret Key
TOKEN_SECRET_KEY=zonegate-token-secret-key-initial-scaffold

# Console sign-in
SESSION_TTL_HOURS=12
# Leave false while the console is served over plain http; a Secure cookie is
# never sent back over one.
SESSION_COOKIE_SECURE=false
# Password given to the auto-seeded demo operator on a fresh database. Blank
# leaves the demo actor unable to sign in to the console.
DEMO_OPERATOR_PASSWORD=zonegate-demo
