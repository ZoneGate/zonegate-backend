# The API image plus the dev dependencies the test suite needs.
#
# Zova ships no Windows wheel, so the suite can only run on Linux. This image
# is how a developer on any host runs it, and it is self-contained: it does not
# assume the API image has already been built locally.

FROM python:3.14-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# `--all-extras`/dev group brings in pytest, which the production image omits.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project

COPY README.md pyproject.toml uv.lock /app/
COPY src/ /app/src/
COPY scripts/ /app/scripts/

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen

WORKDIR /src
CMD ["/app/.venv/bin/python", "-m", "pytest", "tests", "-q"]
